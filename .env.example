# === BioShield AI - variaveis de ambiente (copie para .env e ajuste) ===
# NUNCA comite o .env real nem segredos.

# Banco de dados (PostgreSQL 14+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bioshield
DB_SCHEMA=vigilis

# Backend / API
FLASK_ENV=development
SECRET_KEY=troque-esta-chave
JWT_SECRET_KEY=troque-este-jwt

# MFA / KMS (apenas referencias ao cofre - nunca o segredo em si)
KMS_PROVIDER=local
KMS_KEY_REF=vault://kms/bioshield

# ai_edge (visao computacional)
CAMERA_SOURCE=0
PROCESSING_FPS=15
CNN_CONF_THRESHOLD=0.60
T_REMOCAO_SECONDS=5
BACKEND_API_URL=http://localhost:5000/api

# Retencao (LGPD)
EVIDENCE_RETENTION_DAYS=90
EVIDENCE_RETENTION_MAX_DAYS=180
